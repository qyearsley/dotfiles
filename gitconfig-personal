# Settings for everything under ~/hobby, which is personal work on github.com.
#
# Included from ~/.gitconfig by an `includeIf "gitdir:~/hobby/"`, placed after
# the `[include]` of ~/.gitconfig.local so that this wins. That ordering is the
# whole point: a machine's local half can set a different address and turn on
# commit signing, and neither belongs on a personal repo pushed to github.com.
#
# Signing is off rather than merely unconfigured. A signing program named by one
# machine does not exist on another, so a signed commit here would either fail
# to verify for everyone or fail to make at all elsewhere.
#
# Every repo under ~/hobby today also sets these in its own .git/config, so
# this file changes nothing right now. It is here for the next repo cloned
# into ~/hobby, which will not. A repo that inherits another identity does not
# announce it -- you find out from the history, after pushing it in public.

[user]
	# The address these repos already have in their history. Swap in
	# 53232742+qyearsley@users.noreply.github.com if you would rather GitHub
	# hid it.
	email = qyearsley@gmail.com

[commit]
	gpgsign = false

[tag]
	gpgsign = false
