# The portable half of ~/.gitconfig.
#
# Everything host-specific lives in ~/.gitconfig.local, included at the bottom:
# your name and email, and any signing setup, which on a work machine names a
# program that does not exist anywhere else. Git reads the include last, so that
# file can also override anything here.
#
# This file used to be tracked and never synced, excluded from scripts/configs.sh
# as "host-specific" — but only [user] and the signing block ever were. The
# aliases, the push defaults, the delta pager and core.excludesFile are portable
# and were simply missing from the shared copy, which made this file decoration.

[init]
	defaultBranch = main

[alias]
	co = checkout
	nb = checkout -b

[push]
	# Create the upstream branch on first push instead of erroring.
	autoSetupRemote = true
	# Push the current branch to its own name, never anything else.
	default = current

[core]
	# Tracked as gitignore_global in this repo. `~` rather than an absolute
	# path, so the same line works on every machine.
	excludesFile = ~/.gitignore_global
	# Needs delta on PATH (`brew install git-delta`). Portable in the sense
	# that it is not machine-specific, but not free: without the binary,
	# every diff prints "cannot run delta" before falling back to less.
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true    # n/N to jump between files in diff output
	side-by-side = false
	line-numbers = true

# Machine-specific settings: [user], signing, and the map of which directories
# hold personal repos. Kept out of this repo, which is public. Git ignores a
# missing include, so a fresh machine works before the file exists — it just
# commits as whoever `git config --global user.name` says.
#
# Per-directory identity belongs there and not here. An `includeIf "gitdir:..."`
# names a path in someone's home directory, which is a fact about one machine
# rather than a portable setting, and this file is world-readable. Put the
# conditional includes at the *end* of ~/.gitconfig.local, after its [user]
# block, so they override it. gitconfig-personal in this repo is the other half:
# it says what a personal repo should use, and stays silent on where those repos
# live.
[include]
	path = ~/.gitconfig.local
