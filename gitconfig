# Example ~/.gitconfig, the portable half. [user], signing, and anything else
# private or host-specific go in ~/.gitconfig.local, included at the bottom.

[init]
	defaultBranch = main

[alias]
	co = checkout
	nb = checkout -b

[push]
	# Create the upstream branch on first push instead of erroring.
	autoSetupRemote = true
	# Push the current branch to its own name, never anything else.
	default = current

[core]
	# Tracked as gitignore_global in this repo. `~` rather than an absolute
	# path, so the same line works on every machine.
	excludesFile = ~/.gitignore_global
	# Needs delta on PATH (`brew install git-delta`). Portable in the sense
	# that it is not machine-specific, but not free: without the binary,
	# every diff prints "cannot run delta" before falling back to less.
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true    # n/N to jump between files in diff output
	side-by-side = false
	line-numbers = true

# Machine-specific and personal settings: [user], signing, and any
# per-directory `includeIf` blocks. Kept out of this repo, which is public.
# Git ignores a missing include, so a fresh machine works without it.
[include]
	path = ~/.gitconfig.local
