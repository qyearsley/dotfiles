# List all custom shell functions with descriptions.
function funcs() {
  printf "Custom Shell Functions:\n\n"

  for func_file in ~/.zsh/functions/*; do
    local func_name="${func_file:t}"
    local first_line
    first_line=$(head -n 1 "$func_file")
    if [[ "$first_line" == \#* ]]; then
      printf "  %-20s %s\n" "$func_name" "${first_line#\# }"
    else
      printf "  %-20s %s\n" "$func_name" "(no description)"
    fi
  done | sort
}
